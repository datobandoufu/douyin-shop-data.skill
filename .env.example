# ============================================================
# 抖店日报流水线配置示例（复制为 .env 后填写真实值）
# ⚠️ .env 含凭据，严禁提交到版本库 / 公开仓库
# ============================================================

# ---- 登录凭据（运行时注入，仅本次会话使用） ----
DOUDIAN_EMAIL=
DOUDIAN_PASSWORD=

# ---- 店铺名（必填；前 3 字符需能互相区分，用于顶栏品牌匹配） ----
DD_SHOP_A=
DD_SHOP_B=
# DOUDIAN_BRAND：单步运行时指定当前店铺（run-all 自动按店铺设置，一般无需手填）

# ---- 运行时可执行文件（可选，默认 node / python） ----
# DD_NODE=node
# DD_PYTHON=python
# DD_PYTHONPATH=

# ---- Chrome（可选） ----
# DD_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe
# DD_CHROME_USER_DATA=C:/tmp/chrome-debug

# ---- 临时目录（可选） ----
# DD_TMP_DIR=C:/tmp
# DD_DL_DIR=C:/tmp/doudian-dl

# ---- 旧版 Node 的 ws 模块路径（Node >= 22 无需设置） ----
# DD_WS_PATH=
